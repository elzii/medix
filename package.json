{
  "name": "medix",
  "productName": "Medix",
  "version": "1.0.4",
  "description": "GUI for Redis",
  "scripts": {
    "build:renderer": "webpack --config webpack.config.cjs --mode production",
    "build:renderer:dev": "webpack --config webpack.config.cjs --mode development",
    "build:app": "electrobun build --env=stable",
    "build": "npm run build:renderer && npm run build:app",
    "dev": "electrobun dev --watch",
    "start": "electrobun dev"
  },
  "dependencies": {
    "ioredis": "^5.4.2",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "electrobun": "^2.0.1",
    "typescript": "^5.7.3"
  }
}
